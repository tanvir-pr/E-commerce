# Copy to .env before `docker compose up`.
# Compose overrides DATABASE_URL, REDIS_URL, and SMTP_HOST for the api and worker
# so those processes use the Docker service names (postgres, redis, mailpit).
#
# Seed refuses to run when APP_ENV=production AND SEED_ADMIN_PASSWORD is still
# the placeholder below (replace-this-password).
#
# BREACH_CHECK=stub accepts any password of 10 or more characters. The Have I
# Been Pwned k-anonymity check is a stub that returns false in this mode.
# PHONE_REGISTRATION_ENABLED defaults to false. Phone registration stays hidden
# until it is true. SMS_PROVIDER=console logs the phone OTP in the worker only.
# TOTP_ENCRYPTION_KEY is a Fernet key (url-safe base64 of 32 bytes). The value
# below is a local dev key. Generate another for any shared environment:
# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Chromium treats http://localhost as a secure context, so the Secure __Host-
# cookies work on http://localhost. Open the site as http://localhost:3000,
# not http://127.0.0.1:3000.
#
# API_INTERNAL_URL (also accepted as API_URL) is the Next.js server-side proxy
# target for /api/v1. Compose sets http://api:8000. For `next dev` on the host
# without Compose, set API_INTERNAL_URL=http://localhost:8000.
#
# Currency is BDT, stored later as integer poisha (1 BDT = 100 poisha). Week 1
# has no price tables.

APP_ENV=local
SECRET_KEY=local-dev-secret-key-change-me-000000000000
DATABASE_URL=postgresql+asyncpg://store:store@postgres:5432/store
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=store@localhost
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
API_URL=http://api:8000

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-this-password
BREACH_CHECK=stub
PHONE_REGISTRATION_ENABLED=false
SMS_PROVIDER=console
TOTP_ENCRYPTION_KEY=BJhdA0DLXz-FXC-i6Qf69IaQPxvgJAgyQFb81LSfK-c=
